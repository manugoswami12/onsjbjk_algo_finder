(defun lcs (a b i j)
  (if (or (= i (length a)) (= j (length b)))
      (list '() 0)
      (if (eql (aref a i) (aref b j))
          (destructuring-bind (seq len) (lcs a b (1+ i) (1+ j))
            (list (cons (aref a i) seq) (1+ len)))
          (let ((x (lcs a b (1+ i) j))
                (y (lcs a b i (1+ j))))
            (if (> (second x) (second y)) x y)))))
