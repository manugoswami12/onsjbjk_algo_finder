(defun gcd2 (a b) (do () ((zerop b) a) (psetq a b b (mod a b))))
(defun gcdr (a b) (if (zerop b) a (gcdr b (mod a b))))
(defun fact (n) (if (<= n 1) 1 (* n (fact (- n 1)))))
(defun facti (n) (let ((r 1)) (loop for i from 1 to n do (setf r (* r i))) r))
(defun fib (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(defun dsum (n) (let ((s 0)) (do () ((zerop n) s) (setf s (+ s (mod n 10))) (setf n (floor n 10)))))
(defun isort (vec)
  (dotimes (i (1- (length vec)))
    (do ((j i (1- j))) ((minusp j))
      (if (< (aref vec (1+ j)) (aref vec j))
          (rotatef (aref vec (1+ j)) (aref vec j))
          (return))))
  vec)
(defun ssort (vec)
  (let ((n (length vec)))
    (dotimes (i n)
      (let ((m i))
        (loop for j from (1+ i) below n do (when (< (aref vec j) (aref vec m)) (setf m j)))
        (rotatef (aref vec i) (aref vec m))))
    vec))
(defun bsearch (vec x)
  (let ((lo 0) (hi (1- (length vec))))
    (loop while (<= lo hi) do
      (let ((mid (floor (+ lo hi) 2)))
        (cond ((= (aref vec mid) x) (return-from bsearch mid))
              ((< (aref vec mid) x) (setf lo (1+ mid)))
              (t (setf hi (1- mid))))))
    nil))
(defun vmax (vec)
  (let ((m (aref vec 0)))
    (loop for i from 1 below (length vec) do (when (> (aref vec i) m) (setf m (aref vec i))))
    m))
(defun vsum (vec) (let ((s 0)) (dotimes (i (length vec)) (setf s (+ s (aref vec i)))) s))
(defun twice (n) (* 2 n))
(defun countdown (n) (do () ((zerop n) 0) (setf n (- n 1))))
(defun csort (vec comp)
  (dotimes (i (1- (length vec)))
    (do ((j i (1- j))) ((minusp j))
      (if (funcall comp (aref vec (1+ j)) (aref vec j))
          (rotatef (aref vec (1+ j)) (aref vec j))
          (return))))
  vec)
(defun shsort (vec)
  (loop for i from 1 below (length vec) do
    (let ((key (aref vec i)) (j (1- i)))
      (loop while (and (>= j 0) (> (aref vec j) key)) do
        (setf (aref vec (1+ j)) (aref vec j))
        (decf j))
      (setf (aref vec (1+ j)) key)))
  vec)
(defun vcopy (vec out) (dotimes (i (length vec)) (setf (aref out i) (aref vec i))) out)
(defun lastel (vec) (let ((m 0)) (dotimes (i (length vec)) (setf m (aref vec i))) m))
(defun addmod (a b) (mod (+ a b) 7))
(defun countup (n) (let ((i 0)) (loop while (< i n) do (incf i)) i))
(defun vsel (vec comp)
  (dotimes (i (1- (length vec)))
    (let ((best (aref vec i)) (idx i))
      (dotimes (j (- (length vec) i 1))
        (when (funcall comp (aref vec (+ i j 1)) best)
          (setf best (aref vec (+ i j 1)) idx (+ i j 1))))
      (rotatef (aref vec i) (aref vec idx))))
  vec)
(defun vrev (vec)
  (let ((n (length vec)))
    (dotimes (i (floor n 2))
      (let ((k (- n 1 i)))
        (rotatef (aref vec i) (aref vec k))))
    vec))
(defun lsum (l) (let ((s 0)) (dolist (x l) (setf s (+ s x))) s))
(defun pal (s) (string= s (reverse s)))
(defun qsl (list)
  (if (cdr list)
      (flet ((pivot (test) (remove (car list) list :test-not test)))
        (nconc (qsl (pivot #'>)) (pivot #'=) (qsl (pivot #'<))))
      list))
(defun lcount (l) (let ((k 0)) (dolist (x l) (when (> x 0) (setf k (* 3 k)))) k))
(defun rfact (n) (reduce #'* (loop for i from 1 to n collect i)))
(defun rsum (n) (reduce #'+ (loop for i from 1 to n collect i)))
(defun squares (n) (loop for i from 1 to n collect (* i i)))
(defun fibl (n &aux (f0 0) (f1 1))
  (if (< n 2) n
      (loop for n from 2 to n for a = f0 then b and b = f1 then s for s = (+ a b) finally (return s))))
(defun bsr (x v &optional (lo 0) (hi (1- (length v))))
  (if (< hi lo) nil
      (let ((m (floor (+ lo hi) 2)))
        (cond ((> (aref v m) x) (bsr x v lo (1- m)))
              ((< (aref v m) x) (bsr x v (1+ m) hi))
              (t m)))))
(defun bsieve (n)
  (let ((s (make-array (1+ n) :element-type 'bit :initial-element 0)) (out nil))
    (loop for p from 2 to n when (zerop (bit s p))
          do (push p out) (loop for k from (* p p) to n by p do (setf (bit s k) 1)))
    out))
(defun inrange (c) (if (<= 97 c 122) 1 0))
(defun shiftc (h k &aux (c (char-code h)) (b (or (when (<= 97 c 122) 97) (when (<= 65 c 90) 65))))
  (if b (code-char (+ (mod (+ (- c b) k) 26) b)) h))
(defun dotl (a b) (apply #'+ (mapcar #'* a b)))
(defun applyf (f a b) (funcall f a b))
(defun csweep (vec pred)
  (labels ((pass () (loop for i from 1 below (length vec)
                          do (when (funcall pred (aref vec i) (aref vec (1- i)))
                               (rotatef (aref vec i) (aref vec (1- i)))))))
    (pass))
  vec)
(defun dsumb (number base)
  (loop for n = number then q for (q r) = (multiple-value-list (truncate n base)) sum r until (zerop q)))
(defun mergel (l1 l2 comp)
  (let ((rez ()))
    (do () ((and (null l1) (null l2)))
      (let ((i1 (first l1)) (i2 (first l2)))
        (cond ((null i1) (dolist (i l2) (push i rez)) (return))
              ((null i2) (dolist (i l1) (push i rez)) (return))
              ((funcall comp i1 i2) (push i1 rez) (setf l1 (rest l1)))
              (t (push i2 rez) (setf l2 (rest l2))))))
    (reverse rez)))
(defun msort (list comp)
  (if (null (rest list)) list
      (let ((half (floor (length list) 2)))
        (mergel (msort (subseq list 0 half) comp) (msort (subseq list half) comp) comp))))
(defun bsk (val vec &key (less '<) (key 'identity))
  (when (plusp (length vec))
    (let ((beg 0) (end (1- (length vec))))
      (do () ((= beg end))
        (let ((mid (+ beg (floor (- end beg) 2))))
          (if (funcall less (funcall key (aref vec mid)) val) (setf beg (1+ mid)) (setf end mid))))
      (values (aref vec beg) beg))))
(defun bss (val vec &optional (pos 0))
  (if (> (length vec) 1)
      (let* ((mid (floor (length vec) 2)) (cur (aref vec mid)))
        (cond ((< cur val) (bss val (rtl:slice vec mid) (+ pos mid)))
              ((> cur val) (bss val (rtl:slice vec 0 mid) pos))
              (t (+ pos mid))))
      (when (= (aref vec 0) val) pos)))
(defun facta (n &optional (m 1)) (if (zerop n) m (facta (1- n) (* m n))))
(defgeneric gsort (seq pred))
(defmethod gsort ((seq sequence) pred)
  (loop for i from 1 below (length seq)
        do (loop for j from i downto 1
                 do (when (funcall pred (elt seq j) (elt seq (1- j))) (rotatef (elt seq j) (elt seq (1- j))))))
  seq)
(defun m2max (m)
  (let (best)
    (dotimes (i (array-dimension m 0))
      (dotimes (j (array-dimension m 1))
        (when (or (null best) (> (aref m i j) best)) (setf best (aref m i j)))))
    best))
