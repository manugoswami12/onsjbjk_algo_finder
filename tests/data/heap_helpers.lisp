(defun kid-r (i) (* (+ i 1) 2))
(defun kid-l (i) (- (kid-r i) 1))
(defun sift (v root end)
  (let ((l (kid-l root)) (r (kid-r root)))
    (when (< l end)
      (let ((c (if (or (>= r end) (> (aref v l) (aref v r))) l r)))
        (when (> (aref v c) (aref v root))
          (rotatef (aref v root) (aref v c))
          (sift v c end))))))
(defun hsort (v)
  (loop for i from (1- (floor (length v) 2)) downto 0 do (sift v i (length v)))
  (loop for e from (1- (length v)) downto 1 do (rotatef (aref v 0) (aref v e)) (sift v 0 e))
  v)
(defun twice-plus (x) (+ (* x x) 1))
(defun usesq (v) (let ((s 0)) (dotimes (i (length v)) (setf s (+ s (twice-plus (aref v i))))) s))
